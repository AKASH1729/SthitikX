# ---------- STAGE 1: BUILD ----------
FROM node:18-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# ---------- STAGE 2: RUNTIME ----------
FROM node:18-alpine
WORKDIR /app

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY --from=builder /app /app

# 🔥 CRITICAL FIX
RUN mkdir -p /app/logs \
    && chown -R appuser:appgroup /app \
    && chmod -R 775 /app

USER appuser

ENV NODE_ENV=production
EXPOSE 5000

CMD ["npm", "start"]
